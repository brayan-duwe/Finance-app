# Copy this file to .env and fill in the values.
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Database: a PostgreSQL connection string, e.g. from Supabase (Connect > Direct > Session pooler).
# Leave empty to use a local SQLite file (db.sqlite3).
DATABASE_URL=

# AI assistant: create a key at https://console.anthropic.com (Settings > API keys).
# Leave empty to keep the assistant turned off.
ANTHROPIC_API_KEY=
# Optional: the model (default claude-opus-5-5) and questions per user per day (default 20, 0 = no limit;
# staff accounts are never limited).
# AI_MODEL=claude-haiku-5-5
# AI_DAILY_LIMIT=20

# Production only: extra addresses the site answers to (Render's own address is added automatically).
# ALLOWED_HOSTS=finances.example.com
